{
  "name": "loggym",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "powershell -ExecutionPolicy Bypass -File .\\scripts\\android-dev.ps1",
    "adb:fix": "powershell -ExecutionPolicy Bypass -File .\\scripts\\fix-adb.ps1",
    "android:signingReport": "cd android && gradlew.bat signingReport",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "release:check": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release-doctor.ps1",
    "apk:release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release-build.ps1",
    "firebase:doctor": "powershell -ExecutionPolicy Bypass -File .\\scripts\\firebase-doctor.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint",
    "web:preview": "npm --prefix web run preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@noble/hashes": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/firestore": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "date-fns": "^4.1.0",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.3",
    "react-hook-form": "^7.73.1",
    "react-native": "0.85.2",
    "react-native-config": "^1.6.1",
    "react-native-file-access": "^4.0.3",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-nitro-sqlite": "^9.6.0",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.8.1",
    "uuid": "^14.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
